# ==============================================================================
# Subtivio Studio — Environment Variables Template
# Copy this file to '.env.local' and set your real API keys.
# '.env.local' is strictly ignored by Git and will NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Passwordless Authentication & Email Delivery (Resend)
# ------------------------------------------------------------------------------
# Create a free account at: https://resend.com
# Get your API key under API Keys: https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender email address or Resend test domain
# For testing: "Subtivio <onboarding@resend.dev>" (delivers to your verified Resend account email)
# For production: "Subtivio <auth@yourdomain.com>" (requires domain DNS verification in Resend)
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 2. Database Persistence (MongoDB)
# ------------------------------------------------------------------------------
# Create a free MongoDB Atlas cluster at: https://www.mongodb.com/cloud/atlas
# Or run locally via Docker: docker run -d -p 27017:27017 --name mongo mongo:latest
# Connection URI format:
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/subtivio?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/subtivio
# Note: If MONGODB_URI is left empty, Subtivio automatically uses local fallback storage.
MONGODB_URI=
MONGODB_DB_NAME=

# ------------------------------------------------------------------------------
# 3. Translation Engine Providers (Optional)
# ------------------------------------------------------------------------------
# [Optional] Google Gemini AI API Key
# Enables Gemini 1.5/2.0 Flash subtitle translations as default server provider.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [Optional] OpenAI API Key
# Enables GPT-4o / GPT-4o-mini translations.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [Optional] DeepL API Key
# Supports both free (ending in :fx) and DeepL Pro keys.
# Get a key at: https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ------------------------------------------------------------------------------
# 4. Object Storage (Backblaze B2 - S3-Compatible API)
# ------------------------------------------------------------------------------
# Create a bucket at: https://www.backblaze.com/b2/cloud-storage.html
# Get credentials under "Application Keys" (ApplicationKeyId and ApplicationKey).
# Endpoint format: https://s3.<region>.backblazeb2.com (e.g., https://s3.us-east-005.backblazeb2.com)
# Note: If B2 credentials are empty, Subtivio uses local storage fallback gracefully.
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# ------------------------------------------------------------------------------
# 5. App Configuration
# ------------------------------------------------------------------------------
# Application URL (used for absolute metadata and callbacks)
NEXT_PUBLIC_APP_URL=

